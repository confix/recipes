{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "recipes",
	"compatibility_date": "2026-07-16",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./workers/app.ts",
	// Served only on the custom domain: one origin for sign-in cookies and MCP
	// OAuth, and no second copy of the app on *.workers.dev. The domain's
	// zone (confix.run) must be on the same Cloudflare account; deploy
	// creates the DNS record and certificate.
	"routes": [{ "pattern": "recipes.confix.run", "custom_domain": true }],
	"workers_dev": false,
	// Declared so `wrangler types` types it without a .dev.vars present.
	"secrets": { "required": ["BETTER_AUTH_SECRET"] },
	// `assets.directory` is intentionally absent: the Cloudflare Vite plugin
	// populates it from the client build output and emits a flattened
	// build/server/wrangler.json at build time.
	//
	// No resource ids: scripts/provision.sh creates or finds D1, KV and
	// Vectorize by name, scripts/deploy.sh pins the KV id into the generated
	// build config, and `wrangler deploy` connects D1 and R2 by name. Any
	// account deploys this file unchanged. See README "Deploying".
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "recipes-db",
			// Must match `out` in drizzle.config.ts. drizzle-kit generates the
			// SQL; wrangler owns applying it.
			"migrations_dir": "drizzle"
		}
	],
	// OAuth clients, grants and tokens for the MCP endpoint
	// (@cloudflare/workers-oauth-provider).
	"kv_namespaces": [{ "binding": "OAUTH_KV" }],
	// Semantic search (docs/design.md, phase 3). Neither service runs
	// locally; `pnpm dev` leaves them disconnected (search falls back to
	// keywords) unless started with REMOTE_BINDINGS=1 after `wrangler login`.
	// Each user's vectors live in their own namespace. The index (1024
	// dimensions, cosine, metadata index on `kind`) is created by
	// scripts/provision.sh.
	"ai": { "binding": "AI" },
	"vectorize": [{ "binding": "VECTORIZE", "index_name": "recipes" }],
	// Account emails: address confirmation and password reset
	// (app/lib/mail.server.ts), through Cloudflare Email Sending. The sending
	// domain must be onboarded once (README "Deploying"). `pnpm dev` does not
	// send: wrangler writes each message to a local file and logs its path.
	"send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["recipes@confix.run"] }],
	// Sign-up is public, so the auth forms are rate limited
	// (app/lib/rate-limit.server.ts): per client IP, and per email address
	// for anything that sends mail. Counters are per Cloudflare location and
	// approximate; they stop floods, not a patient attacker. namespace_id is
	// any number unique to this account; nothing to provision.
	"ratelimits": [
		{ "name": "AUTH_IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
		{ "name": "AUTH_EMAIL_LIMITER", "namespace_id": "1002", "simple": { "limit": 2, "period": 60 } }
	],
	// Daily: remove accounts that never confirmed their email address
	// (app/lib/purge-unverified.server.ts).
	"triggers": { "crons": ["17 3 * * *"] },
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "recipes-uploads"
		}
	]
}
