{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "recipes",
	"compatibility_date": "2026-07-16",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./workers/app.ts",
	// Declared so `wrangler types` types them without a .dev.vars present.
	"secrets": { "required": ["BETTER_AUTH_SECRET"] },
	// `assets.directory` is intentionally absent: the Cloudflare Vite plugin
	// populates it from the client build output and emits a flattened
	// build/server/wrangler.json at build time.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "recipes-db",
			"database_id": "local",
			// Must match `out` in drizzle.config.ts. drizzle-kit generates the
			// SQL; wrangler owns applying it.
			"migrations_dir": "drizzle"
		}
	],
	// OAuth clients, grants and tokens for the MCP endpoint
	// (@cloudflare/workers-oauth-provider). Create one with
	// `wrangler kv namespace create OAUTH_KV` and put its id here before deploying.
	"kv_namespaces": [{ "binding": "OAUTH_KV", "id": "local" }],
	// Semantic search (docs/design.md, phase 3). Neither service runs
	// locally; `pnpm dev` leaves them disconnected (search falls back to
	// keywords) unless started with REMOTE_BINDINGS=1 after `wrangler login`.
	// Each user's vectors live in their own namespace. Create the index once,
	// before the first deploy; the metadata index must exist before any vector:
	//   wrangler vectorize create recipes --dimensions=1024 --metric=cosine
	//   wrangler vectorize create-metadata-index recipes --property-name=kind --type=string
	"ai": { "binding": "AI" },
	"vectorize": [{ "binding": "VECTORIZE", "index_name": "recipes" }],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "recipes-uploads"
		}
	]
}
